#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
PROJECTS_FILE="${PROJECTS_FILE:-$REPO/projects.toml}"

# Optional local config — set MACHINE_USE_1PASSWORD, ONEPASS_SOCK, etc. here
# without having to export them every shell. Gitignored.
if [ -f "$REPO/.env" ]; then
  set -a; . "$REPO/.env"; set +a
fi

# We embed Python heredocs that import tomllib (3.11+). Catch the missing-stdlib
# case up front with a clear message rather than a stack trace mid-command.
if ! python3 -c 'import tomllib' >/dev/null 2>&1; then
  echo "machine: python3 with tomllib (3.11+) is required on the host." >&2
  echo "  macOS 14+ ships 3.12 system Python; otherwise: brew install python@3.12" >&2
  exit 1
fi

# SSH agent selection. Default: leave SSH_AUTH_SOCK alone (macOS's launchd
# agent, which serves keys loaded via `ssh-add --apple-use-keychain`).
#
# To use 1Password's SSH agent instead, set MACHINE_USE_1PASSWORD=1 (with the
# 1Password desktop app's "Use the SSH agent" setting enabled). Override the
# socket path with ONEPASS_SOCK if your install is non-standard.
ONEPASS_SOCK="${ONEPASS_SOCK:-$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock}"
if [ "${MACHINE_USE_1PASSWORD:-0}" = "1" ]; then
  if [ ! -S "$ONEPASS_SOCK" ]; then
    echo "machine: MACHINE_USE_1PASSWORD=1 but 1Password agent socket not found at $ONEPASS_SOCK" >&2
    echo "  Open 1Password → Settings → Developer → 'Use the SSH agent'." >&2
    exit 1
  fi
  export SSH_AUTH_SOCK="$ONEPASS_SOCK"
fi

usage() {
  cat <<EOF
Usage: machine <command> [<project>] [args...]

Commands:
  list (alias: ps)        List projects from projects.toml with live VM status
  doctor                  Preflight: lima, git config, SSH agent, signing key, op CLI
  validate                Schema-check projects.toml and referenced profiles (no VM)
  up <project>            Create (if needed) + start + provision + clone the project repo(s)
                          (--dry-run prints provision steps without executing)
  down <project>          Stop the VM
  ssh <project>           Open an interactive shell (cwd = ~/code/<primary-repo>)
  run <project> <cmd>...  Run a non-interactive command in the VM
  secrets <p> [<repo>]    Render 1Password Environment(s) into VM tmpfs
  secrets --clear <p> [<repo>]
                          Wipe rendered secrets from VM tmpfs (all envs, or one repo)
  status <project>        Print status
  destroy <project>       Delete the VM (irreversible)
  rebuild <project>       Destroy + up (reproducibility test)
  update <project>        Refresh in-place (apt upgrade, npm globals, claude installer)
                          (--reprovision also re-applies TOML configs without rebuild)
  bake [--force]          Build/refresh the cached base image used by 'up'
                          (auto-runs on first 'up'; --force ignores hash check)

projects.toml entries take this shape:

  default_profile = "cypress"     # applied when a project doesn't set profiles

  [<name>]
  repos    = ["git@github.com:org/repo.git", ...]
  profiles = ["cypress", "supabase-fly"]   # optional; defaults to [default_profile]

Profiles live in profiles/<name>.toml and stack on top of provision.toml.
EOF
}

# --- TOML helpers (delegate to python3 -- already on macOS) -----------------

# Print every URL in the project's `repos` list, one per line.
project_urls() {
  local name="$1"
  [ -f "$PROJECTS_FILE" ] || {
    echo "machine: $PROJECTS_FILE not found. Copy projects.toml.example and edit." >&2
    return 1
  }
  python3 - "$name" "$PROJECTS_FILE" <<'PY'
import sys, tomllib
name, path = sys.argv[1], sys.argv[2]
cfg = tomllib.loads(open(path).read())
project = cfg.get(name)
if not isinstance(project, dict):
    sys.exit(f"machine: project '{name}' not in {path}")
for url in project.get("repos", []):
    print(url)
PY
}

# Print the profile names that should stack onto provision.toml for this project.
project_profiles() {
  local name="$1"
  [ -f "$PROJECTS_FILE" ] || return 1
  python3 - "$name" "$PROJECTS_FILE" <<'PY'
import sys, tomllib
name, path = sys.argv[1], sys.argv[2]
cfg = tomllib.loads(open(path).read())
project = cfg.get(name) or {}
default = cfg.get("default_profile")
profiles = project.get("profiles")
if profiles is None:
    profiles = [default] if default else []
for p in profiles:
    print(p)
PY
}

# Print the login shell for this project: explicit `shell` field, else top-level
# `default_shell`, else "zsh". Allowed: zsh, fish, bash.
project_shell() {
  local name="$1"
  [ -f "$PROJECTS_FILE" ] || { echo zsh; return 0; }
  python3 - "$name" "$PROJECTS_FILE" <<'PY'
import sys, tomllib
name, path = sys.argv[1], sys.argv[2]
cfg = tomllib.loads(open(path).read())
project = cfg.get(name) or {}
shell = project.get("shell") if isinstance(project, dict) else None
if shell is None:
    shell = cfg.get("default_shell", "zsh")
if shell not in ("zsh", "fish", "bash"):
    sys.exit(f"machine: invalid shell '{shell}' for project '{name}' (use zsh|fish|bash)")
print(shell)
PY
}

# Basename of a git URL, minus the .git suffix.
repo_basename() {
  basename -s .git "$1"
}

# Validate a Lima VM name (a-z 0-9 hyphen, starting alphanumeric).
validate_name() {
  local name="$1"
  if ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "machine: invalid project name '$name' (use a-z, 0-9, hyphen)" >&2
    return 1
  fi
}

# --- File push to the VM ---------------------------------------------------

# Push provision.toml, selected profile TOMLs, the dispatcher, and the files/
# tree (direnv helper, git templates, profile.d snippets) into /opt/dev-vm/
# inside the VM.
push_files_to_vm() {
  local vm="$1"; shift
  local profiles=("$@")

  limactl shell "$vm" -- sudo mkdir -p \
    /opt/dev-vm/profiles \
    /opt/dev-vm/provision \
    /opt/dev-vm/files/direnv \
    /opt/dev-vm/files/fish \
    /opt/dev-vm/files/git \
    /opt/dev-vm/files/profile.d \
    /opt/dev-vm/files/ssh \
    /opt/dev-vm/files/zsh

  # Base provision config + dispatcher.
  limactl shell "$vm" -- sudo tee /opt/dev-vm/provision.toml \
    < "$REPO/provision.toml" >/dev/null
  limactl shell "$vm" -- sudo tee /opt/dev-vm/provision/run.py \
    < "$REPO/provision/run.py" >/dev/null
  limactl shell "$vm" -- sudo chmod 0755 /opt/dev-vm/provision/run.py

  # Only push the profiles this project actually uses. Guard the array
  # expansion: empty arrays trip `set -u` on macOS bash 3.2 (used by `bake`,
  # which calls this with no profiles).
  for p in ${profiles[@]+"${profiles[@]}"}; do
    [ -n "$p" ] || continue
    local src="$REPO/profiles/$p.toml"
    [ -f "$src" ] || { echo "machine: missing profile file $src" >&2; return 1; }
    limactl shell "$vm" -- sudo tee "/opt/dev-vm/profiles/$p.toml" < "$src" >/dev/null
  done

  # files/ tree (everything under files/ except dynamically-rendered git stuff
  # — that gets pushed separately by render_git_templates).
  # `shopt -p nullglob` returns 1 when the option is unset (the default), which
  # would trip `set -e`. Capture state with `|| true`, then restore.
  local saved_nullglob; saved_nullglob=$(shopt -p nullglob || true)
  shopt -s nullglob
  for f in "$REPO"/files/direnv/* "$REPO"/files/fish/* "$REPO"/files/profile.d/* "$REPO"/files/ssh/* "$REPO"/files/zsh/*; do
    [ -f "$f" ] || continue
    local rel="${f#"$REPO"/files/}"
    limactl shell "$vm" -- sudo tee "/opt/dev-vm/files/$rel" < "$f" >/dev/null
  done
  eval "$saved_nullglob"
}

# Invoke the dispatcher with the base config and any profile configs.
# Honors MACHINE_DRY_RUN=1 (passthrough --dry-run) and MACHINE_PROVISION_LOG
# (tee output to this path on the host).
run_provision_in_vm() {
  local vm="$1"; shift
  local profiles=("$@")
  local args="/opt/dev-vm/provision.toml"
  # Empty-array guard for `set -u` (callers like `bake` pass no profiles).
  for p in ${profiles[@]+"${profiles[@]}"}; do
    [ -n "$p" ] || continue
    args="$args /opt/dev-vm/profiles/$p.toml"
  done
  local extra=""
  [ "${MACHINE_DRY_RUN:-0}" = "1" ] && extra="--dry-run"

  # MACHINE_SHELL is set by the caller (cmd_up / cmd_update --reprovision) from
  # the project's `shell` field. Pass it through sudo so the dispatcher's bash
  # cmds can expand ${MACHINE_SHELL:-zsh}. Unset for `bake` → zsh fallback.
  local shell_env=""
  [ -n "${MACHINE_SHELL:-}" ] && shell_env="MACHINE_SHELL=$MACHINE_SHELL"

  if [ -n "${MACHINE_PROVISION_LOG:-}" ]; then
    mkdir -p "$(dirname "$MACHINE_PROVISION_LOG")"
    # shellcheck disable=SC2086  # word-splitting on $args/$extra/$shell_env is intentional
    limactl shell "$vm" -- sudo $shell_env python3 /opt/dev-vm/provision/run.py $extra $args 2>&1 \
      | tee "$MACHINE_PROVISION_LOG"
    # PIPESTATUS lookup via bash builtin.
    return "${PIPESTATUS[0]}"
  fi
  # shellcheck disable=SC2086  # word-splitting on $args/$extra/$shell_env is intentional
  limactl shell "$vm" -- sudo $shell_env python3 /opt/dev-vm/provision/run.py $extra $args
}

# --- Git template rendering (host-side) -------------------------------------

# Read the SSH signing pubkey. Resolution order:
#   1. GIT_SIGNING_KEY  — literal pubkey string (wins outright)
#   2. OP_SIGNING_KEY_REF  — 1Password secret reference, read via `op read`
#                           (requires the 1Password CLI; triggers Touch ID)
#   3. GIT_SIGNING_PUBKEY_FILE  — path to a .pub file
#   4. host's `git config --global user.signingkey` (literal pubkey or path)
read_signing_key() {
  if [ -n "${GIT_SIGNING_KEY:-}" ]; then
    printf '%s' "$GIT_SIGNING_KEY"
    return
  fi
  if [ -n "${OP_SIGNING_KEY_REF:-}" ]; then
    command -v op >/dev/null || {
      echo "machine: OP_SIGNING_KEY_REF set but 'op' CLI not found (brew install 1password-cli)" >&2
      return 1
    }
    op read "$OP_SIGNING_KEY_REF" | tr -d '\n'
    return
  fi
  if [ -n "${GIT_SIGNING_PUBKEY_FILE:-}" ]; then
    if [ ! -r "$GIT_SIGNING_PUBKEY_FILE" ]; then
      echo "machine: GIT_SIGNING_PUBKEY_FILE not readable at $GIT_SIGNING_PUBKEY_FILE" >&2
      return 1
    fi
    tr -d '\n' < "$GIT_SIGNING_PUBKEY_FILE"
    return
  fi
  local host_key
  host_key="$(git config --global user.signingkey 2>/dev/null || true)"
  if [ -z "$host_key" ]; then
    echo "machine: no signing pubkey found" >&2
    echo "  Set one on the host: git config --global user.signingkey 'ssh-ed25519 AAAA...'" >&2
    echo "  Or override per-invocation: GIT_SIGNING_KEY=<literal>, GIT_SIGNING_PUBKEY_FILE=<path>, OP_SIGNING_KEY_REF=op://..." >&2
    return 1
  fi
  case "$host_key" in
    key::*)  printf '%s' "${host_key#key::}" ;;
    ssh-*|ecdsa-*|sk-ssh-*|sk-ecdsa-*)
             printf '%s' "$host_key" ;;
    *)       if [ -r "$host_key" ]; then
               tr -d '\n' < "$host_key"
             else
               echo "machine: host user.signingkey is not a literal pubkey and not a readable file: $host_key" >&2
               return 1
             fi ;;
  esac
}

render_git_templates() {
  local vm="$1"
  local gname email sigkey
  gname="${GIT_NAME:-$(git config --global user.name || true)}"
  email="${GIT_EMAIL:-$(git config --global user.email || true)}"
  sigkey=$(read_signing_key)
  [ -n "$gname" ] && [ -n "$email" ] && [ -n "$sigkey" ] \
    || { echo "machine: missing git name/email/signing key" >&2; return 1; }

  local out="$REPO/.build/$vm/git"
  mkdir -p "$out"
  # Use python str.replace rather than sed -e so delimiter conflicts in the
  # value can't break the substitution.
  GIT_NAME="$gname" GIT_EMAIL="$email" GIT_SIGNING_KEY="$sigkey" \
    python3 - "$REPO/files/git/gitconfig.tpl" "$out/gitconfig" \
            "$REPO/files/git/allowed_signers.tpl" "$out/allowed_signers" <<'PY'
import os, sys
subs = {
    "__GIT_NAME__": os.environ["GIT_NAME"],
    "__GIT_EMAIL__": os.environ["GIT_EMAIL"],
    "__GIT_SIGNING_KEY__": os.environ["GIT_SIGNING_KEY"],
}
for src, dst in zip(sys.argv[1::2], sys.argv[2::2]):
    body = open(src).read()
    for k, v in subs.items():
        body = body.replace(k, v)
    open(dst, "w").write(body)
PY

  limactl shell "$vm" -- sudo mkdir -p /opt/dev-vm/files/git
  limactl shell "$vm" -- sudo tee /opt/dev-vm/files/git/gitconfig < "$out/gitconfig" >/dev/null
  limactl shell "$vm" -- sudo tee /opt/dev-vm/files/git/allowed_signers < "$out/allowed_signers" >/dev/null
}

# --- Project commands -------------------------------------------------------

cmd_list() {
  if [ ! -f "$PROJECTS_FILE" ]; then
    echo "no $PROJECTS_FILE — copy projects.toml.example and edit"
    return 0
  fi
  # Pull live VM state once so the table reflects reality (a destroyed VM
  # shows as "—", not as if it still existed).
  local lima_status
  lima_status=$(limactl list --format='{{.Name}} {{.Status}}' 2>/dev/null || true)

  python3 - "$PROJECTS_FILE" <<PY
import sys, tomllib
cfg = tomllib.loads(open(sys.argv[1]).read())
default = cfg.get("default_profile")
lines = """$lima_status""".strip().splitlines()
status = {l.split()[0]: " ".join(l.split()[1:]) for l in lines if l.strip()}
print(f"{'NAME':<20}  {'STATUS':<12}  {'PROFILES':<20}  REPO")
for name, project in cfg.items():
    if not isinstance(project, dict):
        continue
    repos = project.get("repos", [])
    profiles = project.get("profiles", [default] if default else [])
    profile_str = ",".join(p for p in profiles if p) or "-"
    primary = repos[0] if repos else "-"
    extra = f" (+{len(repos)-1})" if len(repos) > 1 else ""
    st = status.get(name, "—")
    print(f"{name:<20}  {st:<12}  {profile_str:<20}  {primary}{extra}")
PY
}

# --- Golden image (cached pre-provisioned base disk) ------------------------
# Boot a throwaway VM, run the *base* provision.toml only, snapshot the disk,
# reuse it as the starting point for every subsequent VM. Profiles still stack
# on top per-VM. Hash of (provision.toml + provision/run.py) invalidates cache.
GOLDEN_DIR="$HOME/.cache/machine"

golden_arch_tag() {
  case "$(uname -m)" in
    arm64|aarch64) echo "arm64" ;;
    x86_64)        echo "amd64" ;;
    *)             uname -m ;;
  esac
}

golden_lima_arch() {
  case "$(uname -m)" in
    arm64|aarch64) echo "aarch64" ;;
    x86_64)        echo "x86_64" ;;
    *)             uname -m ;;
  esac
}

golden_hash() {
  cat "$REPO/provision.toml" "$REPO/provision/run.py" | shasum -a 256 | cut -c1-16
}

golden_img()   { echo "$GOLDEN_DIR/base-$(golden_arch_tag).img"; }
golden_stamp() { echo "$GOLDEN_DIR/base-$(golden_arch_tag).hash"; }

golden_fresh() {
  local img stamp
  img=$(golden_img); stamp=$(golden_stamp)
  [ -f "$img" ] && [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$(golden_hash)" ]
}

# Render lima.yaml for $vm into .build/<vm>/lima.yaml, prepending the cached
# image as the highest-priority `images:` entry when one is available.
render_lima_yaml() {
  local vm="$1"
  local out="$REPO/.build/$vm/lima.yaml"
  mkdir -p "$(dirname "$out")"
  if golden_fresh; then
    python3 - "$REPO/lima.yaml" "$out" "$(golden_img)" "$(golden_lima_arch)" <<'PY'
import sys
src, dst, img, arch = sys.argv[1:]
out = []
inserted = False
for line in open(src):
    out.append(line)
    if not inserted and line.rstrip() == "images:":
        out.append(f'  - location: "file://{img}"\n')
        out.append(f'    arch: "{arch}"\n')
        inserted = True
open(dst, "w").write("".join(out))
PY
  else
    cp "$REPO/lima.yaml" "$out"
  fi
  printf '%s\n' "$out"
}

cmd_bake() {
  local force=0
  case "${1:-}" in
    --force) force=1 ;;
    "")      ;;
    *) echo "machine bake: unknown flag '$1' (use --force to rebuild)" >&2; return 1 ;;
  esac
  if [ $force -eq 0 ] && golden_fresh; then
    echo "[bake] cache fresh ($(golden_hash)) — use --force to rebuild"
    return 0
  fi
  mkdir -p "$GOLDEN_DIR"

  local vm="machine-base"
  if limactl list -q | grep -qx "$vm"; then
    echo "[bake] removing stale '$vm'"
    limactl stop -f "$vm" 2>/dev/null || true
    limactl delete -f "$vm"
  fi

  echo "[bake] creating base VM (~5 min, base provision only)"
  # Use raw lima.yaml — we are creating the cache, can't reference it.
  limactl create --tty=false --name="$vm" "$REPO/lima.yaml"
  limactl start "$vm"
  push_files_to_vm "$vm"            # no profiles
  render_git_templates "$vm"
  local ts; ts=$(date -u +%Y%m%dT%H%M%SZ)
  MACHINE_PROVISION_LOG="$REPO/.build/$vm/provision-$ts.log" \
    run_provision_in_vm "$vm"        # no profile args
  limactl stop "$vm"

  local src="$HOME/.lima/$vm/disk"
  [ -f "$src" ] || { echo "[bake] expected disk at $src" >&2; return 1; }
  local img; img=$(golden_img)
  echo "[bake] exporting $src → $img"
  # APFS clonefile (cp -c) is near-instant and preserves sparseness; fall back
  # to plain cp if -c isn't supported (non-APFS, non-macOS).
  cp -c "$src" "$img.tmp" 2>/dev/null || cp "$src" "$img.tmp"
  mv "$img.tmp" "$img"
  golden_hash > "$(golden_stamp)"

  limactl delete -f "$vm"
  echo "[bake] done — $img"
}

# Auto-bake on first `up` if no fresh cache exists. Silent if cache is good.
ensure_golden_image() {
  if golden_fresh; then return 0; fi
  echo "[machine] no fresh base image cached — baking (one-time per provision.toml change)"
  cmd_bake
}

cmd_up() {
  local name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) export MACHINE_DRY_RUN=1 ;;
      --) shift; name="${1:-}"; break ;;
      -*) echo "machine up: unknown flag '$1'" >&2; return 1 ;;
      *)  name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || { echo "usage: machine up [--dry-run] <project>" >&2; return 1; }
  validate_name "$name"
  local urls profiles
  urls=$(project_urls "$name")
  profiles=$(project_profiles "$name")
  MACHINE_SHELL=$(project_shell "$name")
  export MACHINE_SHELL

  if ! limactl list -q | grep -qx "$name"; then
    ensure_golden_image
    local lima_yaml; lima_yaml=$(render_lima_yaml "$name")
    limactl create --tty=false --name="$name" "$lima_yaml"
  fi
  limactl start "$name"

  # Read profiles into an array (newline-separated).
  local profile_arr=()
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    profile_arr+=("$p")
  done <<< "$profiles"

  push_files_to_vm "$name" "${profile_arr[@]}"
  render_git_templates "$name"
  # Capture provision output to .build/<vm>/provision-<timestamp>.log unless
  # the caller already set MACHINE_PROVISION_LOG.
  if [ -z "${MACHINE_PROVISION_LOG:-}" ]; then
    local ts; ts=$(date -u +%Y%m%dT%H%M%SZ)
    export MACHINE_PROVISION_LOG="$REPO/.build/$name/provision-$ts.log"
    echo "[machine] provision log: $MACHINE_PROVISION_LOG"
  fi
  run_provision_in_vm "$name" "${profile_arr[@]}"

  # Clone repos in parallel. Each clone serializes its own deps install.
  local pids=() rc=0
  while IFS= read -r url; do
    [ -n "$url" ] || continue
    clone_repo "$name" "$url" &
    pids+=("$!")
  done <<< "$urls"
  for pid in "${pids[@]}"; do
    wait "$pid" || rc=$?
  done
  if [ "$rc" -eq 0 ]; then
    echo "[machine] '$name' is ready — run 'machine ssh $name' to log in."
  fi
  return $rc
}

# Clone one repo into ~/code/<basename>/ inside the VM. Idempotent.
clone_repo() {
  local name="$1" url="$2"
  local repo_name; repo_name=$(repo_basename "$url")
  local qurl qrepo
  qurl=$(printf '%q' "$url")
  qrepo=$(printf '%q' "$repo_name")

  if limactl shell "$name" -- bash -lc "[ -d \"\$HOME/code/$qrepo/.git\" ]" </dev/null; then
    echo "[clone] $repo_name: already present (skip)"
    return 0
  fi
  echo "[clone] $repo_name from $url"
  # known_hosts is pre-seeded with github.com keys at provision time, so we
  # can use yes (strict) for known hosts. accept-new is the fallback for any
  # other host the user might add (gitlab, self-hosted, ...).
  limactl shell "$name" -- env GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new -o UpdateHostKeys=no" \
    bash -lc "mkdir -p \"\$HOME/code\" && cd \"\$HOME/code\" && git clone --recurse-submodules -- $qurl" </dev/null

  # Install JS deps if package.json is present. Try yarn first (most common in
  # repos with packageManager pinned), fall back to npm install.
  limactl shell "$name" -- bash -lc "
    cd \"\$HOME/code/$qrepo\" 2>/dev/null || exit 0
    [ -f package.json ] || exit 0
    if grep -q '\"packageManager\":[[:space:]]*\"yarn' package.json 2>/dev/null; then
      echo '[deps] yarn install'
      yarn install
    elif grep -q '\"packageManager\":[[:space:]]*\"pnpm' package.json 2>/dev/null; then
      echo '[deps] pnpm install'
      pnpm install
    else
      echo '[deps] npm install'
      npm install
    fi
  " </dev/null || echo "[deps] $repo_name: install failed (continuing)"
}

cmd_down() {
  local name="${1:?usage: machine down <project>}"
  limactl stop "$name"
}

cmd_ssh() {
  local name="${1:?usage: machine ssh <project>}"
  local url; url=$(project_urls "$name" 2>/dev/null | head -1 || true)
  if [ -n "$url" ]; then
    local repo_name qrepo
    repo_name=$(repo_basename "$url")
    qrepo=$(printf '%q' "$repo_name")
    if limactl shell "$name" -- bash -lc "[ -d \"\$HOME/code/$qrepo\" ]" </dev/null 2>/dev/null; then
      exec limactl shell --workdir "/home/$USER.linux/code/$repo_name" "$name"
    fi
  fi
  exec limactl shell "$name"
}

cmd_status() {
  local name="${1:?usage: machine status <project>}"
  limactl list "$name"
}

cmd_destroy() {
  local name="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--force|--yes) force=1 ;;
      -*) echo "machine destroy: unknown flag '$1'" >&2; return 1 ;;
      *)  name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || { echo "usage: machine destroy [-y] <project>" >&2; return 1; }
  if [ "$force" -ne 1 ]; then
    read -r -p "Destroy VM '$name'? [y/N] " ans
    [ "$ans" = "y" ] || { echo "aborted"; exit 1; }
  fi
  limactl stop -f "$name" 2>/dev/null || true
  limactl delete "$name"
}

cmd_rebuild() {
  local name="" force=0 dry_run_passthrough=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--force|--yes) force=1 ;;
      --dry-run)        dry_run_passthrough+=("--dry-run") ;;
      -*) echo "machine rebuild: unknown flag '$1'" >&2; return 1 ;;
      *)  name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || { echo "usage: machine rebuild [-y] [--dry-run] <project>" >&2; return 1; }
  if [ "$force" -ne 1 ]; then
    cat <<EOF
This will DESTROY the VM '$name' (cloned repos, branches, shell history) and
recreate it from scratch.

To refresh in place without losing state, use:  machine update $name
EOF
    read -r -p "Type the VM name '$name' to confirm: " ans
    [ "$ans" = "$name" ] || { echo "aborted"; exit 1; }
  fi
  limactl stop -f "$name" 2>/dev/null || true
  limactl delete "$name" 2>/dev/null || true
  if [ "${#dry_run_passthrough[@]}" -gt 0 ]; then
    cmd_up "${dry_run_passthrough[@]}" "$name"
  else
    cmd_up "$name"
  fi
}

cmd_run() {
  local name="${1:?usage: machine run <project> <cmd>...}"; shift
  limactl shell "$name" -- "$@"
}

cmd_update() {
  local name="" reprovision=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --reprovision) reprovision=1 ;;
      -*) echo "machine update: unknown flag '$1'" >&2; return 1 ;;
      *)  name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || { echo "usage: machine update [--reprovision] <project>" >&2; return 1; }
  if [ "$reprovision" -eq 1 ]; then
    local profiles profile_arr=()
    profiles=$(project_profiles "$name")
    MACHINE_SHELL=$(project_shell "$name")
    export MACHINE_SHELL
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      profile_arr+=("$p")
    done <<< "$profiles"
    push_files_to_vm "$name" "${profile_arr[@]}"
    render_git_templates "$name"
    run_provision_in_vm "$name" "${profile_arr[@]}"
  fi
  # shellcheck disable=SC2016  # body runs inside the VM
  limactl shell "$name" -- sudo bash -c '
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get -y upgrade
    apt-get -y autoremove
  '
  # shellcheck disable=SC2016  # body runs inside the VM
  limactl shell "$name" -- bash -lc '
    set -e
    corepack prepare pnpm@latest --activate
    npm update -g @openai/codex typescript typescript-language-server
    curl -fsSL https://claude.ai/install.sh | bash
    # Refresh the plugin marketplace and update each installed plugin.
    # Treat "already up to date" / "no updates" output as success but surface
    # any other non-zero exit.
    run_claude() {
      out=$(claude "$@" 2>&1); rc=$?
      if [ $rc -eq 0 ]; then printf "%s\n" "$out"; return 0; fi
      if printf "%s" "$out" | grep -qi -e "already" -e "up to date" -e "no updates"; then
        printf "%s\n" "$out"; return 0
      fi
      printf "%s\n" "$out" >&2; return $rc
    }
    run_claude plugin marketplace update claude-plugins-official || true
    for p in $(claude plugin list 2>/dev/null | awk "NR>1 {print \$1}"); do
      run_claude plugin update "$p" || true
    done
  '
  echo "update OK"
}

# --- Secrets command (unchanged from previous version) ----------------------

extract_env_id() {
  local vm="$1" envrc_path="$2"
  limactl shell "$vm" -- bash -lc "grep -oE 'use[[:space:]]+op_env[[:space:]]+[a-z0-9]+' '$envrc_path' 2>/dev/null | awk '{print \$3}' | head -1"
}

sync_one_env() {
  local vm="$1" env_id="$2" repo="$3"
  echo "[secrets] $repo ($env_id)"
  local rendered
  rendered=$(op environment read "$env_id" --no-masking 2>&1) || {
    echo "  failed: $rendered" >&2
    return 1
  }
  # shellcheck disable=SC2016  # script body runs inside the VM
  printf '%s\n' "$rendered" | limactl shell "$vm" -- bash -c '
    set -e
    dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dev-secrets"
    mkdir -p "$dir"; chmod 700 "$dir"
    cache="$dir/$1.env"
    cat > "$cache"
    chmod 600 "$cache"
  ' bash "$env_id"
}

cmd_secrets_clear() {
  local name="${1:?usage: machine secrets --clear <project> [<repo>]}"
  local target_repo="${2:-}"
  if [ -z "$target_repo" ]; then
    # shellcheck disable=SC2016  # script body runs inside the VM
    limactl shell "$name" -- bash -lc '
      dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dev-secrets"
      if [ -d "$dir" ]; then
        # Best-effort overwrite, then unlink.
        find "$dir" -maxdepth 1 -type f -name "*.env" -exec sh -c "head -c $(wc -c <\"\$1\") /dev/zero > \"\$1\" 2>/dev/null; rm -f \"\$1\"" _ {} \;
        rmdir "$dir" 2>/dev/null || true
        echo "[secrets] cleared $dir"
      else
        echo "[secrets] no cache dir on $(hostname)"
      fi
    '
    return
  fi
  # Single-repo clear: look up the env id from that repo's .envrc.
  local envrc_path env_id
  envrc_path=$(limactl shell "$name" -- bash -lc "ls \$HOME/code/$(printf '%q' "$target_repo")/.envrc 2>/dev/null || true")
  if [ -z "$envrc_path" ]; then
    echo "no .envrc for repo '$target_repo' in VM '$name'" >&2
    return 1
  fi
  env_id=$(extract_env_id "$name" "$envrc_path")
  if [ -z "$env_id" ]; then
    echo "no 'use op_env <id>' line in $envrc_path" >&2
    return 1
  fi
  # shellcheck disable=SC2016  # script body runs inside the VM
  limactl shell "$name" -- bash -c '
    dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dev-secrets"
    cache="$dir/$1.env"
    if [ -f "$cache" ]; then
      head -c "$(wc -c <"$cache")" /dev/zero > "$cache" 2>/dev/null || true
      rm -f "$cache"
      echo "[secrets] cleared $cache"
    else
      echo "[secrets] $cache not present"
    fi
  ' bash "$env_id"
}

cmd_secrets() {
  if [ "${1:-}" = "--clear" ]; then
    shift
    cmd_secrets_clear "$@"
    return $?
  fi
  local name="${1:?usage: machine secrets [--clear] <project> [<repo>]}"
  local target_repo="${2:-}"
  command -v op >/dev/null || {
    echo "machine: 'op' CLI required (brew install 1password-cli)" >&2
    return 1
  }

  local count=0
  local envrcs
  # shellcheck disable=SC2016  # script body runs inside the VM
  envrcs=$(limactl shell "$name" -- bash -lc '
    find ~/code -mindepth 2 -maxdepth 3 -name .envrc -type f 2>/dev/null
  ')

  while IFS= read -r path; do
    [ -n "$path" ] || continue
    local repo
    repo=$(basename "$(dirname "$path")")
    if [ -n "$target_repo" ] && [ "$target_repo" != "$repo" ]; then
      continue
    fi
    local env_id
    env_id=$(extract_env_id "$name" "$path")
    if [ -z "$env_id" ]; then
      [ -n "$target_repo" ] && echo "no 'use op_env <id>' line in $path" >&2
      continue
    fi
    sync_one_env "$name" "$env_id" "$repo" && count=$((count + 1))
  done <<< "$envrcs"

  if [ "$count" -eq 0 ]; then
    if [ -n "$target_repo" ]; then
      echo "no .envrc found for repo '$target_repo' in VM '$name' (expected ~/code/$target_repo/.envrc)" >&2
    else
      echo "no repos with 'use op_env' .envrc found under ~/code in VM '$name'" >&2
    fi
    return 1
  fi
  echo "synced $count environment(s)"
}

# --- Doctor: preflight checks -----------------------------------------------

cmd_doctor() {
  local fails=0
  local checks=0

  _check() {
    checks=$((checks + 1))
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      printf '  ok  %s\n' "$label"
    else
      printf '  FAIL %s\n' "$label" >&2
      fails=$((fails + 1))
    fi
  }
  _check_with_output() {
    checks=$((checks + 1))
    local label="$1" output
    shift
    output=$("$@" 2>&1) || {
      printf '  FAIL %s — %s\n' "$label" "$output" >&2
      fails=$((fails + 1))
      return
    }
    printf '  ok  %s — %s\n' "$label" "$output"
  }

  echo "[doctor] host"
  _check "limactl on PATH"               command -v limactl
  _check "python3 with tomllib"          python3 -c 'import tomllib'
  _check_with_output "git user.name"     git config --global user.name
  _check_with_output "git user.email"    git config --global user.email

  echo "[doctor] ssh"
  if [ "${MACHINE_USE_1PASSWORD:-0}" = "1" ]; then
    _check "1Password agent socket"      test -S "$ONEPASS_SOCK"
  fi
  if [ -n "${SSH_AUTH_SOCK:-}" ]; then
    _check "SSH agent reachable"         ssh-add -l
    if ! ssh-add -l 2>/dev/null | grep -qE '^(256|384|521|2048|3072|4096)'; then
      # shellcheck disable=SC2016  # backticks are literal here, not command subst
      printf '  WARN  no keys in agent — load one with `ssh-add --apple-use-keychain ~/.ssh/id_ed25519`\n' >&2
    fi
  else
    printf '  FAIL SSH_AUTH_SOCK unset\n' >&2
    fails=$((fails + 1))
  fi

  echo "[doctor] signing key"
  local sig
  if sig=$(read_signing_key 2>&1); then
    printf '  ok  signing pubkey resolves (%d bytes)\n' "${#sig}"
  else
    printf '  FAIL signing pubkey — %s\n' "$sig" >&2
    fails=$((fails + 1))
  fi

  if [ -n "${OP_SIGNING_KEY_REF:-}" ] || [ -f "$PROJECTS_FILE" ] && grep -q 'op_env' "${PROJECTS_FILE:-/dev/null}" 2>/dev/null; then
    echo "[doctor] 1Password"
    _check "op CLI installed"            command -v op
  fi

  echo "[doctor] config"
  _check "projects.toml present"         test -f "$PROJECTS_FILE"
  if [ -f "$PROJECTS_FILE" ]; then
    _check "projects.toml parses"        python3 -c "import tomllib; tomllib.loads(open('$PROJECTS_FILE').read())"
  fi

  echo
  if [ "$fails" -gt 0 ]; then
    printf '%d/%d checks failed\n' "$fails" "$checks" >&2
    return 1
  fi
  printf 'all %d checks passed\n' "$checks"
}

# --- Validate: schema-check the TOMLs without touching a VM -----------------

cmd_validate() {
  python3 - "$REPO" "$PROJECTS_FILE" <<'PY'
import sys, tomllib
from pathlib import Path
repo = Path(sys.argv[1])
projects_file = Path(sys.argv[2])

errors: list[str] = []

def err(msg: str) -> None:
    errors.append(msg)

# --- projects.toml ---
if not projects_file.exists():
    err(f"{projects_file}: not found (copy projects.toml.example and edit)")
else:
    try:
        cfg = tomllib.loads(projects_file.read_text())
    except tomllib.TOMLDecodeError as e:
        err(f"{projects_file}: parse error: {e}")
        cfg = {}
    default_profile = cfg.get("default_profile")
    if default_profile is not None and not isinstance(default_profile, str):
        err("default_profile must be a string")
    default_shell = cfg.get("default_shell")
    if default_shell is not None and default_shell not in ("zsh", "fish", "bash"):
        err("default_shell must be one of: zsh, fish, bash")
    referenced_profiles: set[str] = set()
    for name, project in cfg.items():
        if name in ("default_profile", "default_shell"):
            continue
        if not isinstance(project, dict):
            continue
        if not name.replace("-", "").isalnum() or not name[0].isalnum() or not name.islower():
            err(f"[{name}]: invalid name (use lowercase a-z, 0-9, hyphen, starting alphanumeric)")
        repos = project.get("repos")
        if not isinstance(repos, list) or not repos or not all(isinstance(r, str) for r in repos):
            err(f"[{name}]: repos must be a non-empty list of strings")
        profiles = project.get("profiles", [default_profile] if default_profile else [])
        if not isinstance(profiles, list) or not all(isinstance(p, str) for p in profiles if p is not None):
            err(f"[{name}]: profiles must be a list of strings")
        for p in profiles:
            if p:
                referenced_profiles.add(p)
        shell = project.get("shell")
        if shell is not None and shell not in ("zsh", "fish", "bash"):
            err(f"[{name}]: shell must be one of: zsh, fish, bash")
    if default_profile:
        referenced_profiles.add(default_profile)
    for p in referenced_profiles:
        path = repo / "profiles" / f"{p}.toml"
        if not path.exists():
            err(f"profile '{p}' referenced but {path} not found")
        else:
            try:
                tomllib.loads(path.read_text())
            except tomllib.TOMLDecodeError as e:
                err(f"profiles/{p}.toml: parse error: {e}")

# --- provision.toml ---
provision = repo / "provision.toml"
if not provision.exists():
    err("provision.toml not found")
else:
    try:
        tomllib.loads(provision.read_text())
    except tomllib.TOMLDecodeError as e:
        err(f"provision.toml: parse error: {e}")

if errors:
    print("validation failed:", file=sys.stderr)
    for e in errors:
        print(f"  - {e}", file=sys.stderr)
    sys.exit(1)
print("validation OK")
PY
}

# --- ps: configured + running state -----------------------------------------

# --- Dispatch ---------------------------------------------------------------

case "${1:-}" in
  list|ps)  shift; cmd_list "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  validate) shift; cmd_validate "$@" ;;
  up)       shift; cmd_up "$@" ;;
  down)     shift; cmd_down "$@" ;;
  ssh)      shift; cmd_ssh "$@" ;;
  status)   shift; cmd_status "$@" ;;
  destroy)  shift; cmd_destroy "$@" ;;
  rebuild)  shift; cmd_rebuild "$@" ;;
  run)      shift; cmd_run "$@" ;;
  secrets)  shift; cmd_secrets "$@" ;;
  update)   shift; cmd_update "$@" ;;
  bake)     shift; cmd_bake "$@" ;;
  ""|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
