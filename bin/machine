#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
PROJECTS_FILE="${PROJECTS_FILE:-$REPO/projects.toml}"

# SSH agent selection. Default: leave SSH_AUTH_SOCK alone (macOS's launchd
# agent, which serves keys loaded via `ssh-add --apple-use-keychain`).
#
# To use 1Password's SSH agent instead, set MACHINE_USE_1PASSWORD=1 (with the
# 1Password desktop app's "Use the SSH agent" setting enabled). Override the
# socket path with ONEPASS_SOCK if your install is non-standard.
ONEPASS_SOCK="${ONEPASS_SOCK:-$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock}"
if [ "${MACHINE_USE_1PASSWORD:-0}" = "1" ]; then
  if [ ! -S "$ONEPASS_SOCK" ]; then
    echo "machine: MACHINE_USE_1PASSWORD=1 but 1Password agent socket not found at $ONEPASS_SOCK" >&2
    echo "  Open 1Password → Settings → Developer → 'Use the SSH agent'." >&2
    exit 1
  fi
  export SSH_AUTH_SOCK="$ONEPASS_SOCK"
fi

usage() {
  cat <<EOF
Usage: machine <command> [<project>] [args...]

Commands:
  list                    List projects from projects.toml
  up <project>            Create (if needed) + start + provision + clone the project repo(s)
  down <project>          Stop the VM
  ssh <project>           Open an interactive shell (cwd = ~/code/<primary-repo>)
  run <project> <cmd>...  Run a non-interactive command in the VM
  secrets <p> [<repo>]    Render 1Password Environment(s) into VM tmpfs
  status <project>        Print status
  destroy <project>       Delete the VM (irreversible)
  rebuild <project>       Destroy + up (reproducibility test)
  update <project>        Refresh in-place (apt upgrade, npm globals, claude installer)

projects.toml entries take this shape:

  default_profile = "cypress"     # applied when a project doesn't set profiles

  [<name>]
  repos    = ["git@github.com:org/repo.git", ...]
  profiles = ["cypress", "supabase-fly"]   # optional; defaults to [default_profile]

Profiles live in profiles/<name>.toml and stack on top of provision.toml.
EOF
}

# --- TOML helpers (delegate to python3 -- already on macOS) -----------------

# Print every URL in the project's `repos` list, one per line.
project_urls() {
  local name="$1"
  [ -f "$PROJECTS_FILE" ] || {
    echo "machine: $PROJECTS_FILE not found. Copy projects.toml.example and edit." >&2
    return 1
  }
  python3 - "$name" "$PROJECTS_FILE" <<'PY'
import sys, tomllib
name, path = sys.argv[1], sys.argv[2]
cfg = tomllib.loads(open(path).read())
project = cfg.get(name)
if not isinstance(project, dict):
    sys.exit(f"machine: project '{name}' not in {path}")
for url in project.get("repos", []):
    print(url)
PY
}

# Print the profile names that should stack onto provision.toml for this project.
project_profiles() {
  local name="$1"
  [ -f "$PROJECTS_FILE" ] || return 1
  python3 - "$name" "$PROJECTS_FILE" <<'PY'
import sys, tomllib
name, path = sys.argv[1], sys.argv[2]
cfg = tomllib.loads(open(path).read())
project = cfg.get(name) or {}
default = cfg.get("default_profile")
profiles = project.get("profiles")
if profiles is None:
    profiles = [default] if default else []
for p in profiles:
    print(p)
PY
}

# Basename of a git URL, minus the .git suffix.
repo_basename() {
  basename -s .git "$1"
}

# Validate a Lima VM name (a-z 0-9 hyphen, starting alphanumeric).
validate_name() {
  local name="$1"
  if ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "machine: invalid project name '$name' (use a-z, 0-9, hyphen)" >&2
    return 1
  fi
}

# --- File push to the VM ---------------------------------------------------

# Push provision.toml, selected profile TOMLs, the dispatcher, and the files/
# tree (direnv helper, git templates, profile.d snippets) into /opt/dev-vm/
# inside the VM.
push_files_to_vm() {
  local vm="$1"; shift
  local profiles=("$@")

  limactl shell "$vm" -- sudo mkdir -p \
    /opt/dev-vm/profiles \
    /opt/dev-vm/provision \
    /opt/dev-vm/files/direnv \
    /opt/dev-vm/files/git \
    /opt/dev-vm/files/profile.d

  # Base provision config + dispatcher.
  limactl shell "$vm" -- sudo tee /opt/dev-vm/provision.toml \
    < "$REPO/provision.toml" >/dev/null
  limactl shell "$vm" -- sudo tee /opt/dev-vm/provision/run.py \
    < "$REPO/provision/run.py" >/dev/null
  limactl shell "$vm" -- sudo chmod 0755 /opt/dev-vm/provision/run.py

  # Only push the profiles this project actually uses.
  for p in "${profiles[@]}"; do
    [ -n "$p" ] || continue
    local src="$REPO/profiles/$p.toml"
    [ -f "$src" ] || { echo "machine: missing profile file $src" >&2; return 1; }
    limactl shell "$vm" -- sudo tee "/opt/dev-vm/profiles/$p.toml" < "$src" >/dev/null
  done

  # files/ tree (everything under files/ except dynamically-rendered git stuff
  # — that gets pushed separately by render_git_templates).
  shopt -s nullglob
  for f in "$REPO"/files/direnv/* "$REPO"/files/profile.d/*; do
    [ -f "$f" ] || continue
    local rel="${f#"$REPO"/files/}"
    limactl shell "$vm" -- sudo tee "/opt/dev-vm/files/$rel" < "$f" >/dev/null
  done
}

# Invoke the dispatcher with the base config and any profile configs.
run_provision_in_vm() {
  local vm="$1"; shift
  local profiles=("$@")
  local args="/opt/dev-vm/provision.toml"
  for p in "${profiles[@]}"; do
    [ -n "$p" ] || continue
    args="$args /opt/dev-vm/profiles/$p.toml"
  done
  # shellcheck disable=SC2086  # word-splitting on $args is intentional
  limactl shell "$vm" -- sudo python3 /opt/dev-vm/provision/run.py $args
}

# --- Git template rendering (host-side) -------------------------------------

# Read the SSH signing pubkey. Resolution order:
#   1. GIT_SIGNING_KEY  — literal pubkey string (wins outright)
#   2. OP_SIGNING_KEY_REF  — 1Password secret reference, read via `op read`
#                           (requires the 1Password CLI; triggers Touch ID)
#   3. GIT_SIGNING_PUBKEY_FILE  — path to a .pub file
#   4. host's `git config --global user.signingkey` (literal pubkey or path)
read_signing_key() {
  if [ -n "${GIT_SIGNING_KEY:-}" ]; then
    printf '%s' "$GIT_SIGNING_KEY"
    return
  fi
  if [ -n "${OP_SIGNING_KEY_REF:-}" ]; then
    command -v op >/dev/null || {
      echo "machine: OP_SIGNING_KEY_REF set but 'op' CLI not found (brew install 1password-cli)" >&2
      return 1
    }
    op read "$OP_SIGNING_KEY_REF" | tr -d '\n'
    return
  fi
  if [ -n "${GIT_SIGNING_PUBKEY_FILE:-}" ]; then
    if [ ! -r "$GIT_SIGNING_PUBKEY_FILE" ]; then
      echo "machine: GIT_SIGNING_PUBKEY_FILE not readable at $GIT_SIGNING_PUBKEY_FILE" >&2
      return 1
    fi
    tr -d '\n' < "$GIT_SIGNING_PUBKEY_FILE"
    return
  fi
  local host_key
  host_key="$(git config --global user.signingkey 2>/dev/null || true)"
  if [ -z "$host_key" ]; then
    echo "machine: no signing pubkey found" >&2
    echo "  Set one on the host: git config --global user.signingkey 'ssh-ed25519 AAAA...'" >&2
    echo "  Or override per-invocation: GIT_SIGNING_KEY=<literal>, GIT_SIGNING_PUBKEY_FILE=<path>, OP_SIGNING_KEY_REF=op://..." >&2
    return 1
  fi
  case "$host_key" in
    key::*)  printf '%s' "${host_key#key::}" ;;
    ssh-*|ecdsa-*|sk-ssh-*|sk-ecdsa-*)
             printf '%s' "$host_key" ;;
    *)       if [ -r "$host_key" ]; then
               tr -d '\n' < "$host_key"
             else
               echo "machine: host user.signingkey is not a literal pubkey and not a readable file: $host_key" >&2
               return 1
             fi ;;
  esac
}

render_git_templates() {
  local vm="$1"
  local gname email sigkey
  gname="${GIT_NAME:-$(git config --global user.name || true)}"
  email="${GIT_EMAIL:-$(git config --global user.email || true)}"
  sigkey=$(read_signing_key)
  [ -n "$gname" ] && [ -n "$email" ] && [ -n "$sigkey" ] \
    || { echo "machine: missing git name/email/signing key" >&2; return 1; }

  local out="$REPO/.build/$vm/git"
  mkdir -p "$out"
  sed -e "s|__GIT_NAME__|$gname|g" \
      -e "s|__GIT_EMAIL__|$email|g" \
      -e "s|__GIT_SIGNING_KEY__|$sigkey|g" \
      "$REPO/files/git/gitconfig.tpl" > "$out/gitconfig"
  sed -e "s|__GIT_EMAIL__|$email|g" \
      -e "s|__GIT_SIGNING_KEY__|$sigkey|g" \
      "$REPO/files/git/allowed_signers.tpl" > "$out/allowed_signers"

  limactl shell "$vm" -- sudo mkdir -p /opt/dev-vm/files/git
  limactl shell "$vm" -- sudo tee /opt/dev-vm/files/git/gitconfig < "$out/gitconfig" >/dev/null
  limactl shell "$vm" -- sudo tee /opt/dev-vm/files/git/allowed_signers < "$out/allowed_signers" >/dev/null
}

# --- Project commands -------------------------------------------------------

cmd_list() {
  if [ ! -f "$PROJECTS_FILE" ]; then
    echo "no $PROJECTS_FILE — copy projects.toml.example and edit"
    return 0
  fi
  python3 - "$PROJECTS_FILE" <<'PY'
import sys, tomllib
cfg = tomllib.loads(open(sys.argv[1]).read())
default = cfg.get("default_profile")
for name, project in cfg.items():
    if not isinstance(project, dict):
        continue
    repos = project.get("repos", [])
    profiles = project.get("profiles", [default] if default else [])
    profile_str = ",".join(p for p in profiles if p) or "-"
    primary = repos[0] if repos else "-"
    extra = f" (+{len(repos)-1})" if len(repos) > 1 else ""
    print(f"{name:<20}  [{profile_str}]  {primary}{extra}")
PY
}

cmd_up() {
  local name="${1:?usage: machine up <project>}"
  validate_name "$name"
  local urls profiles
  urls=$(project_urls "$name")
  profiles=$(project_profiles "$name")

  if ! limactl list -q | grep -qx "$name"; then
    limactl create --name="$name" "$REPO/lima.yaml"
  fi
  limactl start "$name"

  # Read profiles into an array (newline-separated).
  local profile_arr=()
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    profile_arr+=("$p")
  done <<< "$profiles"

  push_files_to_vm "$name" "${profile_arr[@]}"
  render_git_templates "$name"
  run_provision_in_vm "$name" "${profile_arr[@]}"

  while IFS= read -r url; do
    [ -n "$url" ] || continue
    clone_repo "$name" "$url"
  done <<< "$urls"
}

# Clone one repo into ~/code/<basename>/ inside the VM. Idempotent.
clone_repo() {
  local name="$1" url="$2"
  local repo_name; repo_name=$(repo_basename "$url")

  if limactl shell "$name" -- bash -lc "[ -d \"\$HOME/code/$repo_name/.git\" ]" </dev/null; then
    echo "[clone] $repo_name: already present (skip)"
    return 0
  fi
  echo "[clone] $repo_name from $url"
  limactl shell "$name" -- env GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new" \
    bash -lc "mkdir -p \$HOME/code && cd \$HOME/code && git clone --recurse-submodules $url" </dev/null

  # Install JS deps if package.json is present. Try yarn first (most common in
  # repos with packageManager pinned), fall back to npm install.
  limactl shell "$name" -- bash -lc "
    cd \$HOME/code/$repo_name 2>/dev/null || exit 0
    [ -f package.json ] || exit 0
    if grep -q '\"packageManager\":[[:space:]]*\"yarn' package.json 2>/dev/null; then
      echo '[deps] yarn install'
      yarn install
    elif grep -q '\"packageManager\":[[:space:]]*\"pnpm' package.json 2>/dev/null; then
      echo '[deps] pnpm install'
      pnpm install
    else
      echo '[deps] npm install'
      npm install
    fi
  " </dev/null || echo "[deps] $repo_name: install failed (continuing)"
}

cmd_down() {
  local name="${1:?usage: machine down <project>}"
  limactl stop "$name"
}

cmd_ssh() {
  local name="${1:?usage: machine ssh <project>}"
  local url; url=$(project_urls "$name" 2>/dev/null | head -1 || true)
  if [ -n "$url" ]; then
    local repo_name; repo_name=$(repo_basename "$url")
    if limactl shell "$name" -- bash -lc "[ -d \"\$HOME/code/$repo_name\" ]" </dev/null 2>/dev/null; then
      exec limactl shell --workdir "/home/$USER.linux/code/$repo_name" "$name"
    fi
  fi
  exec limactl shell "$name"
}

cmd_status() {
  local name="${1:?usage: machine status <project>}"
  limactl list "$name"
}

cmd_destroy() {
  local name="${1:?usage: machine destroy <project>}"
  read -r -p "Destroy VM '$name'? [y/N] " ans
  [ "$ans" = "y" ] || { echo "aborted"; exit 1; }
  limactl stop -f "$name" 2>/dev/null || true
  limactl delete "$name"
}

cmd_rebuild() {
  local name="${1:?usage: machine rebuild <project>}"
  cat <<EOF
This will DESTROY the VM '$name' (cloned repos, branches, shell history) and
recreate it from scratch.

To refresh in place without losing state, use:  machine update $name
EOF
  read -r -p "Type the VM name '$name' to confirm: " ans
  [ "$ans" = "$name" ] || { echo "aborted"; exit 1; }
  limactl stop -f "$name" 2>/dev/null || true
  limactl delete "$name" 2>/dev/null || true
  cmd_up "$name"
}

cmd_run() {
  local name="${1:?usage: machine run <project> <cmd>...}"; shift
  limactl shell "$name" -- "$@"
}

cmd_update() {
  local name="${1:?usage: machine update <project>}"
  # shellcheck disable=SC2016  # body runs inside the VM
  limactl shell "$name" -- sudo bash -c '
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get -y upgrade
    apt-get -y autoremove
  '
  # shellcheck disable=SC2016  # body runs inside the VM
  limactl shell "$name" -- bash -lc '
    set -e
    corepack prepare pnpm@latest --activate
    npm update -g @openai/codex typescript typescript-language-server
    curl -fsSL https://claude.ai/install.sh | bash
    # Refresh the plugin marketplace and update each installed plugin.
    claude plugin marketplace update claude-plugins-official 2>/dev/null || true
    for p in $(claude plugin list 2>/dev/null | awk "NR>1 {print \$1}"); do
      claude plugin update "$p" 2>/dev/null || true
    done
  '
  echo "update OK"
}

# --- Secrets command (unchanged from previous version) ----------------------

extract_env_id() {
  local vm="$1" envrc_path="$2"
  limactl shell "$vm" -- bash -lc "grep -oE 'use[[:space:]]+op_env[[:space:]]+[a-z0-9]+' '$envrc_path' 2>/dev/null | awk '{print \$3}' | head -1"
}

sync_one_env() {
  local vm="$1" env_id="$2" repo="$3"
  echo "[secrets] $repo ($env_id)"
  local rendered
  rendered=$(op environment read "$env_id" --no-masking 2>&1) || {
    echo "  failed: $rendered" >&2
    return 1
  }
  # shellcheck disable=SC2016  # script body runs inside the VM
  printf '%s\n' "$rendered" | limactl shell "$vm" -- bash -c '
    set -e
    dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dev-secrets"
    mkdir -p "$dir"; chmod 700 "$dir"
    cache="$dir/$1.env"
    cat > "$cache"
    chmod 600 "$cache"
  ' bash "$env_id"
}

cmd_secrets() {
  local name="${1:?usage: machine secrets <project> [<repo>]}"
  local target_repo="${2:-}"
  command -v op >/dev/null || {
    echo "machine: 'op' CLI required (brew install 1password-cli)" >&2
    return 1
  }

  local count=0
  local envrcs
  # shellcheck disable=SC2016  # script body runs inside the VM
  envrcs=$(limactl shell "$name" -- bash -lc '
    find ~/code -mindepth 2 -maxdepth 3 -name .envrc -type f 2>/dev/null
  ')

  while IFS= read -r path; do
    [ -n "$path" ] || continue
    local repo
    repo=$(basename "$(dirname "$path")")
    if [ -n "$target_repo" ] && [ "$target_repo" != "$repo" ]; then
      continue
    fi
    local env_id
    env_id=$(extract_env_id "$name" "$path")
    if [ -z "$env_id" ]; then
      [ -n "$target_repo" ] && echo "no 'use op_env <id>' line in $path" >&2
      continue
    fi
    sync_one_env "$name" "$env_id" "$repo" && count=$((count + 1))
  done <<< "$envrcs"

  if [ "$count" -eq 0 ]; then
    if [ -n "$target_repo" ]; then
      echo "no .envrc found for repo '$target_repo' in VM '$name' (expected ~/code/$target_repo/.envrc)" >&2
    else
      echo "no repos with 'use op_env' .envrc found under ~/code in VM '$name'" >&2
    fi
    return 1
  fi
  echo "synced $count environment(s)"
}

# --- Dispatch ---------------------------------------------------------------

case "${1:-}" in
  list)     shift; cmd_list "$@" ;;
  up)       shift; cmd_up "$@" ;;
  down)     shift; cmd_down "$@" ;;
  ssh)      shift; cmd_ssh "$@" ;;
  status)   shift; cmd_status "$@" ;;
  destroy)  shift; cmd_destroy "$@" ;;
  rebuild)  shift; cmd_rebuild "$@" ;;
  run)      shift; cmd_run "$@" ;;
  secrets)  shift; cmd_secrets "$@" ;;
  update)   shift; cmd_update "$@" ;;
  ""|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
