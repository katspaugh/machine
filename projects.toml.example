# `machine`'s project list. Copy to projects.toml and edit. projects.toml is gitignored.
#
# Schema:
#   default_profile = "<name>"        # optional. Used when a project omits `profiles`.
#   default_shell   = "zsh"           # optional. zsh|bash. Used when a project omits `shell`.
#
#   [<project-name>]                  # becomes the Lima VM name (a-z, 0-9, hyphen).
#   repos    = ["git@github.com:org/repo.git", ...]
#   profiles = ["cypress", ...]       # optional. Stacks on top of the base VM.
#   shell    = "bash"                 # optional. zsh|bash. Login shell inside the VM (default zsh).
#   forward_agent = false             # optional, default true. False = no SSH agent forwarding:
#                                     # the VM gets no channel to your host keys; use a per-project
#                                     # deploy key instead (README → "Restricting the forwarded
#                                     # agent"). Takes effect when the VM is (re)created.
#
# Each profile is a templates/<name>.yaml + provision/<name>.sh pair.
# Each repo is cloned into ~/code/<basename(<git-url>)>/ inside the VM.
# With multiple repos, the first is the "primary" — `machine ssh <name>` opens at its dir.

# default_profile = "cypress"      # off by default: projects without `profiles` get the base VM only.
# default_shell = "zsh"             # bash is also pre-installed in every VM.

# Single-repo project; base VM only (no profiles).
# [blog]
# repos = ["git@github.com:you/blog.git"]

# Multi-repo project: sibling-clones so a dockerized dev env can bind-mount peers.
# [wallet]
# profiles = ["cypress"]
# repos = [
#   "git@github.com:you/safe-wallet-dev-env.git",
#   "git@github.com:you/safe-wallet-monorepo.git",
#   "git@github.com:you/safe-client-gateway.git",
# ]

# Project with multiple profiles stacked.
# [playground]
# profiles = ["cypress", "supabase-fly"]
# repos = ["git@github.com:you/playground.git"]
