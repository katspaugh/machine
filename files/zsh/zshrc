# Installed by `machine` provisioning. Edit files/zsh/zshrc and re-provision.
# Pure-zsh config — no external prompt frameworks or plugin managers.

# --- PATH -------------------------------------------------------------------
# zsh does not read ~/.profile, so the user-bin entries that `.profile` adds
# for bash/sh logins (and that fish sets too) must be set here as well —
# otherwise tools installed under ~/.local/bin (e.g. claude) aren't found.
# typeset -U keeps PATH de-duplicated if this is sourced more than once.
typeset -U path
path=("$HOME/.local/bin" "$HOME/bin" $path)

# --- History ----------------------------------------------------------------
HISTFILE=$HOME/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS \
       HIST_VERIFY INC_APPEND_HISTORY EXTENDED_HISTORY

# --- Navigation -------------------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT

# --- Completion -------------------------------------------------------------
autoload -Uz compinit && compinit -u
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' '+l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- Keybindings (emacs + history search on arrows) ------------------------
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# --- Prompt: user@host  cwd  (git-branch)  $ -------------------------------
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats ' (%b)'
zstyle ':vcs_info:git:*' actionformats ' (%b|%a)'
zstyle ':vcs_info:*' enable git
setopt PROMPT_SUBST
precmd() { vcs_info }
PROMPT='%F{cyan}%n@%m%f %F{yellow}%~%f%F{green}${vcs_info_msg_0_}%f %(?.%F{green}.%F{red})%#%f '

# --- Aliases ----------------------------------------------------------------
alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias grep='grep --color=auto'
alias g='git'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate'

# fd-find on Debian/Ubuntu installs as `fdfind`; alias to the conventional name
# unless the user has installed something else there.
command -v fdfind >/dev/null && ! command -v fd >/dev/null && alias fd='fdfind'

# bat installs as `batcat` on Debian/Ubuntu (name clash with bacula). Same
# pattern as fd; then use it as a nicer cat.
command -v batcat >/dev/null && ! command -v bat >/dev/null && alias bat='batcat'
(( $+commands[bat] || $+aliases[bat] )) && alias cat='bat --paging=never'

# --- fzf (keybindings: Ctrl-R history, Ctrl-T files, Alt-C cd) ---------------
command -v fzf >/dev/null && source <(fzf --zsh)

# --- direnv -----------------------------------------------------------------
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
