{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/katspaugh/machine/schemas/provision.schema.json",
  "title": "machine provision.toml / profiles/*.toml",
  "description": "Declarative provisioning config. Lists concat across base + profiles; scalars use first-writer-wins.",
  "type": "object",
  "definitions": {
    "when": {
      "type": "object",
      "description": "Gates a block on host facts (arch, codename).",
      "additionalProperties": { "type": "string" }
    },
    "apt_block": {
      "type": "object",
      "properties": {
        "packages": { "type": "array", "items": { "type": "string" } },
        "when": { "$ref": "#/definitions/when" }
      },
      "required": ["packages"],
      "additionalProperties": false
    },
    "apt_repo": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "key_url": { "type": "string", "format": "uri" },
        "deb": { "type": "string" },
        "packages": { "type": "array", "items": { "type": "string" } },
        "when": { "$ref": "#/definitions/when" },
        "post_shell": { "type": "string" }
      },
      "required": ["name", "key_url", "deb", "packages"],
      "additionalProperties": false
    },
    "installer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "run_as_user": { "type": "boolean" },
        "verify": { "type": "string" }
      },
      "required": ["name", "url"],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "description": "May contain {arch} placeholder." },
        "bin": { "type": "string" },
        "install_to": { "type": "string" },
        "verify": { "type": "string" }
      },
      "required": ["name", "url", "bin", "install_to"],
      "additionalProperties": false
    },
    "shell_block": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cmd": { "type": "string" },
        "run_as_user": { "type": "boolean" },
        "when": { "$ref": "#/definitions/when" }
      },
      "required": ["cmd"],
      "additionalProperties": false
    }
  },
  "properties": {
    "apt": {
      "oneOf": [
        { "$ref": "#/definitions/apt_block" },
        { "type": "array", "items": { "$ref": "#/definitions/apt_block" } }
      ]
    },
    "apt_repo": {
      "type": "array",
      "items": { "$ref": "#/definitions/apt_repo" }
    },
    "installer": {
      "type": "array",
      "items": { "$ref": "#/definitions/installer" }
    },
    "release": {
      "type": "array",
      "items": { "$ref": "#/definitions/release" }
    },
    "corepack": {
      "type": "object",
      "properties": {
        "prepare": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "npm_global": {
      "type": "object",
      "properties": {
        "packages": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "profile_d": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "claude": {
      "type": "object",
      "properties": {
        "marketplace": { "type": "string" },
        "plugins": { "type": "array", "items": { "type": "string" } },
        "default_permission_mode": { "type": "string" }
      },
      "required": ["marketplace"],
      "additionalProperties": false
    },
    "shell": {
      "type": "array",
      "items": { "$ref": "#/definitions/shell_block" }
    }
  },
  "additionalProperties": false
}
